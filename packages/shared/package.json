{
  "name": "@agentsy/shared",
  "version": "0.0.0",
  "description": "Shared types, utilities, and CortexKit integration for @agentsy",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./safe-path": {
      "types": "./dist/safe-path.d.ts",
      "import": "./dist/safe-path.js",
      "require": "./dist/safe-path.cjs"
    },
    "./cortexkit": {
      "types": "./dist/cortexkit/index.d.ts",
      "import": "./dist/cortexkit/index.js",
      "require": "./dist/cortexkit/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "test": "vitest --run --passWithNoTests",
    "coverage": "vitest --run --coverage"
  },
  "dependencies": {
    "@cortexkit/aft-bridge": "^0.37.1",
    "better-sqlite3": "^12.1.0",
    "type-fest": "5.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
