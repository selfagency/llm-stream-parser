{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "rootDir": "./",
    "outDir": "./dist",
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@agentsy/daemon": ["packages/daemon/src/index.ts"],
      "@agentsy/daemon/*": ["packages/daemon/src/*"],
      "@agentsy/gateway": ["packages/gateway/src/index.ts"],
      "@agentsy/gateway/*": ["packages/gateway/src/*"],
      "@agentsy/bootstrap": ["packages/bootstrap/src/index.ts"],
      "@agentsy/bootstrap/*": ["packages/bootstrap/src/*"],
      "@agentsy/context": ["packages/context/src/index.ts"],
      "@agentsy/guardrails": ["packages/guardrails/src/index.ts"],
      "@agentsy/atlas": ["packages/atlas/src/index.ts"],
      "@agentsy/atlas/*": ["packages/atlas/src/*"],
      "@agentsy/models": ["packages/models/src/index.ts"],
      "@agentsy/models/local-providers": [
        "packages/models/src/local-providers/index.ts"
      ],
      "@agentsy/models/search-contracts": [
        "packages/models/src/search-contracts.ts"
      ],
      "@agentsy/observability": ["packages/observability/src/index.ts"],
      "@agentsy/observability/*": ["packages/observability/src/*"],
      "@agentsy/memory": ["packages/memory/src/index.ts"],
      "@agentsy/memory/*": ["packages/memory/src/*"],
      "@agentsy/secrets": ["packages/secrets/src/index.ts"],
      "@agentsy/session": ["packages/session/src/index.ts"],
      "@agentsy/session/*": ["packages/session/src/*"],
      "@agentsy/shared": ["packages/shared/src/index.ts"],
      "@agentsy/shared/*": ["packages/shared/src/*"],
      "@agentsy/tokenomics": ["packages/tokenomics/src/index.ts"],
      "@agentsy/tokenomics/*": ["packages/tokenomics/src/*"],
      "@agentsy/tools": ["packages/tools/src/index.ts"],
      "@agentsy/tools/*": ["packages/tools/src/*"],
      "@agentsy/ui": ["packages/ui/src/index.ts"],
      "@agentsy/ui/*": ["packages/ui/src/*"],
      "@agentsy/orchestrator": ["packages/orchestrator/src/index.ts"],
      "@agentsy/orchestrator/council": [
        "packages/orchestrator/src/council/index.ts"
      ],
      "@agentsy/orchestrator/*": ["packages/orchestrator/src/*"],
      "@agentsy/core": ["packages/core/src/index.ts"],
      "@agentsy/core/*": ["packages/core/src/*"],
      "@agentsy/providers": ["packages/providers/src/index.ts"],
      "@agentsy/providers/*": ["packages/providers/src/*"],
      "@agentsy/cli": ["packages/cli/src/index.ts"],
      "@agentsy/cli/*": ["packages/cli/src/*"],
      "@agentsy/runtime": ["packages/runtime/src/index.ts"],
      "@agentsy/runtime/*": ["packages/runtime/src/*"],
      "@agentsy/retrieval": ["packages/retrieval/src/index.ts"],
      "@agentsy/retrieval/*": ["packages/retrieval/src/*"]
    },
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true
  },
  "include": ["**/src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
