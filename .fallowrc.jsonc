{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Exclude tooling, docs, and non-framework directories from ALL Fallow analyses.
  // Execute FIRST per remediation plan — eliminates ~40 findings (Phase 10).
  "ignorePatterns": [
    ".agents/**",
    "scripts/**",
    "plan/**",
    "docs/**",
    ".github/**",
    ".husky/**",
    ".opencode/**",
    ".vitepress/**",
    ".zed/**",
    ".cmux/**",
    ".vscode/**",
    "config/**",
    ".fallow/**",
    "coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/*.md",
    "**/*.mdx",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/yarn.lock",
    // Dev-time config files — not source code
    "packages/cli/tui-test.config.ts",
    // Dev convenience scripts — not library code
    "packages/memory/bin/dev.js",
    // Stale package dirs — Phase 2 consolidation artifacts
    "packages/connectors/**",
    "packages/mcp/**",
    "packages/renderers/**",
    "packages/scripts/**",
    "packages/types/**"
  ],
  "publicPackages": [
    "@agentsy/context",
    "@agentsy/core",
    "@agentsy/daemon",
    "@agentsy/gateway",
    "@agentsy/guardrails",
    "@agentsy/memory",
    "@agentsy/models",
    "@agentsy/observability",
    "@agentsy/orchestrator",
    "@agentsy/plugins",
    "@agentsy/prompts",
    "@agentsy/providers",
    "@agentsy/retrieval",
    "@agentsy/runtime",
    "@agentsy/secrets",
    "@agentsy/session",
    "@agentsy/shared",
    "@agentsy/tokenomics",
    "@agentsy/tools",
    "@agentsy/ui"
  ],
  // Explicit entry points for packages when package.json exports are insufficient.
  // Test files are entry points for the test runner — including them prevents
  // false-positive "unused file" reports while still inspecting test code for
  // dead code, complexity, and duplication issues.
  "entry": [
    "packages/runtime/src/approval/index.ts",
    "packages/cli/src/commands/guardrails.ts",
    // Secrets subpath barrel files — entry points for tsup subpath exports
    "packages/secrets/src/config/index.ts",
    "packages/secrets/src/injection/index.ts",
    "packages/secrets/src/provider/index.ts",
    // Test file patterns — avoid false-positive "unused file" reports
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test-d.ts",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    // Subpath entry points — registered as tsup entries for independent consumption
    "packages/runtime/src/ag-ui/index.ts",
    "packages/runtime/src/loop/index.ts",
    "packages/memory/src/cli/index.ts",
    "packages/vscode/src/mcp/index.ts",
    "packages/providers/src/caching/index.ts",
    "packages/providers/src/adapters/index.ts",
    // Internal barrel files — consumed by other files in the same package
    "packages/ui/src/ink/components/agent-log/index.ts",
    "packages/ui/src/ink/components/approval-gate/index.ts",
    "packages/ui/src/ink/components/command-palette/index.ts",
    "packages/ui/src/ink/components/diff-viewer/index.tsx",
    "packages/ui/src/ink/components/document-viewer/index.tsx",
    "packages/ui/src/ink/components/dropdown/index.ts",
    "packages/ui/src/ink/components/orchestrator-console/index.ts",
    "packages/ui/src/ink/components/status-rail/index.ts",
    "packages/ui/src/ink/components/task-progress/index.ts",
    "packages/ui/src/ink/components/workspace-shell/index.ts",
    "packages/ui/src/ink/components/workspace-tree/index.ts",
    // Planned subpath export barrels — not currently imported but represent public API surface
    "packages/memory/src/cortexkit/index.ts",
    "packages/session/src/cortexkit/index.ts",
    "packages/observability/src/exporters/index.ts",
    "packages/observability/src/instrumentation/index.ts",
    "packages/cli/src/providers/index.ts",
    "packages/testing/src/msw/setup.ts",
    // Already a tsup subpath entry — external consumers import via package exports
    "packages/plugins/src/manifest/index.ts",
    // Council mode — optional orchestration pattern
    "packages/orchestrator/src/council/index.ts",
    // Memory CLI — oclif runtime filesystem discovery (no static import chain)
    "packages/memory/src/commands/init.ts",
    "packages/memory/src/commands/mcp.ts",
    "packages/memory/src/commands/daemon/start.ts",
    "packages/memory/src/commands/daemon/status.ts",
    "packages/memory/src/commands/daemon/stop.ts"
  ],
  // Preserve class members that are used via runtime reflection or host integrations.
  "usedClassMembers": [],
  // Duplicate detection tuning (reduce noise for trivial/script duplication during cleanup).
  "duplicates": {
    "threshold": 8,
    "ignoreDefaults": false,
    "ignore": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.jsx", "**/*.test.js", "**/*.spec.ts", "**/*.spec.tsx"],
    "minLines": 8,
    "minTokens": 70
  },
  // Health threshold tuning (will be refined after regenerating coverage).
  // Test files excluded from complexity/health checks — test logic is
  // inherently complex (setup patterns, edge case coverage) and flagging
  // it is noise, not useful signal.
  "health": {
    "maxCyclomatic": 15,
    // Functions with acceptable complexity for their domain
    "ignore": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/governance/policy.ts",
      "**/recovery/policy.ts",
      "**/task-board/in-memory.ts",
      "**/commands/chat.ts",
      "**/agents/loader.ts",
      // Guardrails scanner evaluate() — complexity driven by pattern density, not cyclomatic logic
      "packages/guardrails/src/pipeline.ts",
      "packages/guardrails/src/pii.ts",
      "packages/guardrails/src/policy.ts",
      "packages/guardrails/src/rate-limiter.ts",
      "packages/guardrails/src/test-helpers.ts",
      // Approval handler — safety-critical logic that trades complexity for correctness
      "packages/runtime/src/approval/approval-hook.ts",
      // Diff viewer extraction already done in earlier rounds; remaining complexity is structural
      "packages/renderers/src/ink/components/diff-viewer/index.tsx",
      // CLI-wrapper provider — moderate complexity inherent in CLI parsing patterns
      "packages/secrets/src/provider/local/1password.ts",
      "packages/secrets/src/provider/local/apple-pm.ts",
      "packages/secrets/src/provider/local/bitwarden.ts",
      "packages/secrets/src/provider/local/dashlane.ts",
      "packages/secrets/src/provider/local/lastpass.ts",
      "packages/secrets/src/provider/cloud/doppler.ts",
      "packages/secrets/src/provider/cloud/infisical.ts",
      "packages/secrets/src/provider/cloud/vault.ts",
      "packages/secrets/src/provider/cloud/aws-sm.ts",
      "packages/secrets/src/provider/cloud/gcp-sm.ts",
      "packages/secrets/src/provider/cloud/azure-kv.ts",
      // Shared CLI executor — wraps child_process.execSync with error recovery
      "packages/secrets/src/provider/local/exec.ts",
      // Token resolver — structurally moderate complexity; CRAP high without coverage mapping
      "packages/secrets/src/injection/resolver.ts"
    ]
  },
  // Prevent gating on current baseline during remediation; switch to stronger gate after cleanup.
  "audit": {
    "gate": "new-only"
  },
  // Common workspace aliases and packages we intentionally keep as dev/build
  // references across packages (monorepo layout). These are safe to ignore in
  // fallow's unused-dependencies check.
  // Cloud SDK optional peer deps — used via dynamic import() at runtime
  "ignoreDependencies": [
    "@agentsy/core",
    "@agentsy/runtime",
    "@agentsy/memory",
    "@agentsy/providers",
    "@agentsy/session",
    "@agentsy/context",
    // Cross-package runtime dependencies used via workspace:* protocol
    "@agentsy/gateway",
    "@agentsy/plugins",
    "@agentsy/vscode",
    "@agentsy/guardrails",
    "@agentsy/models",
    "@agentsy/observability",
    "@agentsy/secrets",
    "@agentsy/shared",
    "isolated-vm",
    "zod",
    "@agentsy/tokenomics",
    "better-sqlite3",
    "@libsql/client",
    // Cloud SDK optional peer deps — dynamically imported, never direct deps
    "@aws-sdk/client-secrets-manager",
    "@azure/identity",
    "@azure/keyvault-secrets",
    "@google-cloud/secret-manager",
    "piscina",
    "bree"
  ],
  // Intentional duplicate exports across namespace-barrel module boundaries
  "ignoreExports": [
    { "file": "packages/orchestrator/src/hooks/governance-gate.ts", "exports": ["*"] },
    { "file": "packages/orchestrator/src/hooks/observability.ts", "exports": ["*"] },
    { "file": "packages/orchestrator/src/hooks/recovery-gate.ts", "exports": ["*"] },
    { "file": "packages/gateway/src/types.ts", "exports": ["*"] },
    { "file": "packages/cli/src/config/index.ts", "exports": ["*"] },
    { "file": "packages/cli/src/config/paths.ts", "exports": ["*"] },
    { "file": "packages/cli/src/config/resolve-credentials.ts", "exports": ["*"] },
    { "file": "packages/cli/src/config/schema.ts", "exports": ["BudgetConfig", "ProviderConfig", "ConfigSchema", "DEFAULT_CONFIG", "deepMerge", "loadFromEnv", "loadFromFile"] },
    { "file": "packages/cli/src/config/migrate.ts", "exports": ["CURRENT_CONFIG_VERSION", "migrateConfigFile", "migrateAndLoad"] },
    { "file": "packages/gateway/src/client.ts", "exports": ["*"] },
    { "file": "packages/gateway/src/registry/index.ts", "exports": ["*"] },
    { "file": "packages/memory/src/cli/init-cli.ts", "exports": ["*"] },
    { "file": "packages/memory/src/cli/mcp-server-cli.ts", "exports": ["*"] }
  ]
}
